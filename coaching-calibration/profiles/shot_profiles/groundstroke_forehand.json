{
  "schema_version": "3",
  "profile_id": "groundstroke_forehand",
  "profile_version": "2.0.0",
  "profile_name": "Forehand Groundstroke",
  "description": "Calibration workflow for forehand groundstroke phase labelling, phase-level quality assessment, overall shot assessment, and structured coaching observations.",
  "classification": {
    "shot_class": {
      "id": "groundstroke",
      "label": "Groundstroke"
    },
    "shot_type": {
      "id": "forehand",
      "label": "Forehand"
    },
    "shot_variant": null
  },
  "vocabulary": {
    "phases": {
      "id": "padel_partner_iq_calibration_phases",
      "version": "2.0.0",
      "file": "../../generated/forehand-observation-contract.json",
      "section": "phases"
    },
    "observations": {
      "id": "padel_partner_iq_coaching_observations",
      "version": "2.0.0",
      "file": "../../generated/forehand-observation-contract.json",
      "section": "metrics"
    },
    "ratings": {
      "id": "padel_partner_iq_rating_scale",
      "version": "1.0.0",
      "file": "../ratings.json"
    },
    "quality_assessments": {
      "id": "padel_partner_iq_quality_assessment_scale",
      "version": "1.0.0",
      "file": "../quality_assessments.json"
    },
    "diagnostic_scales": {
      "id": "padel_partner_iq_forehand_diagnostic_scales",
      "version": "1.0.0",
      "file": "../diagnostic_scales.json"
    }
  },
  "phases": [
    {
      "id": "ready_position",
      "shortcut": "1",
      "observation_groups": [
        {"id": "stance", "observations": ["stance_width", "knee_bend", "body_balance"]},
        {"id": "arm_racket_readiness", "observations": ["racket_side_preparation", "racket_preparation_height"]}
      ]
    },
    {
      "id": "max_take_back",
      "shortcut": "2",
      "observation_groups": [
        {"id": "core_stance", "observations": ["court_body_orientation", "shoulder_hip_separation", "body_balance"]},
        {"id": "non_hitting_arm", "observations": ["non_hitting_arm_extension", "non_hitting_arm_orientation"]},
        {"id": "hitting_arm", "observations": ["hitting_arm_structure", "hitting_arm_orientation"]}
      ]
    },
    {
      "id": "contact_point",
      "shortcut": "3",
      "observation_groups": [
        {"id": "core_stance", "observations": ["court_body_orientation", "shoulder_hip_separation", "body_balance"]},
        {"id": "non_hitting_arm", "observations": ["non_hitting_arm_extension", "non_hitting_arm_orientation"]},
        {"id": "hitting_arm", "observations": ["elbow_position", "hitting_arm_extension"]},
        {"id": "contact_positioning", "observations": ["contact_height", "contact_distance", "contact_fore_aft_position"]}
      ]
    },
    {
      "id": "max_follow_through",
      "shortcut": "4",
      "observation_groups": [
        {"id": "core_stance", "observations": ["court_body_orientation", "shoulder_hip_separation", "body_balance"]},
        {"id": "non_hitting_arm", "observations": ["non_hitting_arm_extension", "non_hitting_arm_orientation"]},
        {"id": "hitting_arm", "observations": ["elbow_position", "hitting_arm_extension", "follow_through_height"]}
      ]
    }
  ],
  "ratings": ["not_assessed"],
  "quality_ratings": [
    "not_assessed",
    "excellent",
    "good",
    "needs_work",
    "red_flag"
  ],
  "capture": {
    "requires_overall_quality": false,
    "requires_phase_quality": false,
    "requires_all_phases_for_export": true,
    "allow_duplicate_frame_labels_with_warning": true
  },
  "export": {
    "include_profile_version": true,
    "include_ontology_version": true,
    "include_overall_quality": true,
    "include_overall_notes": true,
    "include_phase_quality": true,
    "include_phase_notes": true,
    "include_structured_observations": true
  }
}
